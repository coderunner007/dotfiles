{
  "permissions": {
    "defaultMode": "plan"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ajoseph/.claude/tmux-session-name.sh start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ajoseph/.claude/tmux-session-name.sh rename"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash /Users/ajoseph/.claude/tmux-session-name.sh stop"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/ajoseph/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "nx-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "nrwl/nx-ai-agents-config"
      }
    },
    "crit": {
      "source": {
        "source": "github",
        "repo": "tomasz-tomczyk/crit",
        "ref": "v0.19.0"
      }
    }
  },
  "effortLevel": "medium",
  "autoMemoryEnabled": false,
  "theme": "dark-ansi",
  "editorMode": "vim"
}
